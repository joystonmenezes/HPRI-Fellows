# Copy this file to ".env.local" and fill in real values.
# .env.local is git-ignored and is read automatically by Next.js.

# --- Email sending (Gmail / Google Workspace) -----------------------------
# Use a Gmail "App Password", NOT your normal password:
#   Google Account  ->  Security  ->  2-Step Verification (turn on)  ->  App passwords
# Create one, copy the 16 characters, and paste below (spaces are fine to remove).
# Email is OPTIONAL: leave SMTP_USER and SMTP_PASS blank to turn it off. The site
# still works and every submission is still saved to the admin dashboard.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM=HPRI Summer Fellows <your-address@gmail.com>

# Where contact + submission notifications are sent (program staff inbox).
# Defaults to SMTP_USER if left blank.
ADMIN_EMAIL=program-inbox@usc.edu

# --- Admin dashboard login (used by the CMS) ------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
# Any long random string; used to sign the admin login session cookie.
# Generate a strong one by running in a terminal:   openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# --- Firebase (Firestore) — stores all editable page content --------------
# LOCAL DEV: just drop the service-account JSON file at the project root as
#   service-account.json   (it is git-ignored). Nothing to set here.
# HOSTING (Vercel etc.) where you can't ship a file: base64-encode the JSON and
# paste the single line below instead. Generate it with:
#   base64 -i service-account.json | tr -d '\n'
# Then paste the result as the value of FIREBASE_SERVICE_ACCOUNT_B64.
# If neither the file nor this var is present, the site falls back to a local
# data/content.json file (fine for testing, but edits won't persist on Vercel).
FIREBASE_SERVICE_ACCOUNT_B64=
